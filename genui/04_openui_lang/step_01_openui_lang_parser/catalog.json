{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Stack": {
      "description": "Lays children out in a column or a row",
      "properties": {
        "children": {"type": "array", "items": {}},
        "direction": {"type": "string", "enum": ["column", "row"], "default": "column"},
        "gap": {"type": "string", "enum": ["s", "m", "l"], "default": "m"}
      },
      "required": ["children"]
    },
    "Text": {
      "description": "A run of text",
      "properties": {
        "text": {"type": "string"},
        "size": {"type": "string", "enum": ["small", "body", "heading"], "default": "body"}
      },
      "required": ["text"]
    },
    "Metric": {
      "description": "One number with a label and an optional change",
      "properties": {
        "label": {"type": "string"},
        "value": {"type": ["string", "number"]},
        "delta": {"type": "string"}
      },
      "required": ["label", "value"]
    },
    "Table": {
      "description": "A table with column headers and rows of cells",
      "properties": {
        "columns": {"type": "array", "items": {"type": "string"}},
        "rows": {"type": "array", "items": {"type": "array", "items": {}}}
      },
      "required": ["columns", "rows"]
    },
    "BarChart": {
      "description": "A bar chart with one series",
      "properties": {
        "title": {"type": "string"},
        "labels": {"type": "array", "items": {"type": "string"}},
        "values": {"type": "array", "items": {"type": "number"}}
      },
      "required": ["title", "labels", "values"]
    },
    "Card": {
      "description": "A bordered box with a title and children",
      "properties": {
        "title": {"type": "string"},
        "children": {"type": "array", "items": {}}
      },
      "required": ["title", "children"]
    },
    "Button": {
      "description": "A button that fires an action name",
      "properties": {
        "label": {"type": "string"},
        "action": {"type": "string"},
        "variant": {"type": "string", "enum": ["primary", "secondary"], "default": "secondary"}
      },
      "required": ["label", "action"]
    },
    "Input": {
      "description": "A single-line text field",
      "properties": {
        "name": {"type": "string"},
        "placeholder": {"type": "string"},
        "type": {"type": "string", "enum": ["text", "email", "number"], "default": "text"}
      },
      "required": ["name"]
    }
  }
}
