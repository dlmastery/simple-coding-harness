{
  "name": "genui-step-02-openui-react-lang",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The real OpenUI Lang stack: @openuidev/lang-core parser, @openuidev/react-lang renderer, a Zod catalog, a generated system prompt, a model streaming to the page.",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "esbuild app.mjs --bundle --format=esm --outfile=static/bundle.js --define:process.env.NODE_ENV=\\\"production\\\" --log-level=warning",
    "prompt": "node prompt.mjs",
    "test": "node --test --test-reporter=tap \"tests/*.test.mjs\"",
    "start": "python server.py"
  },
  "dependencies": {
    "@openuidev/lang-core": "0.2.18",
    "@openuidev/react-lang": "0.2.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
