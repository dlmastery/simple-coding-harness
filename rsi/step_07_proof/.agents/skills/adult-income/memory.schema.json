{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "memory card: IF profile THEN prefer or forbid one field value",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "if",
  "then",
  "evidence",
  "counter"
 ],
 "properties": {
  "if": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "key",
    "op",
    "value"
   ],
   "properties": {
    "key": {
     "enum": [
      "n_rows",
      "n_features",
      "n_classes",
      "imbalance",
      "has_categorical"
     ]
    },
    "op": {
     "enum": [
      ">",
      "<",
      ">=",
      "<=",
      "=="
     ]
    },
    "value": {
     "type": "number"
    }
   }
  },
  "then": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "field"
   ],
   "properties": {
    "field": {
     "enum": [
      "model",
      "hyper",
      "scale",
      "encode",
      "class_weight"
     ]
    },
    "prefer": {
     "type": [
      "string",
      "number",
      "null"
     ]
    },
    "forbid": {
     "type": [
      "string",
      "number",
      "null"
     ]
    }
   },
   "oneOf": [
    {
     "required": [
      "prefer"
     ]
    },
    {
     "required": [
      "forbid"
     ]
    }
   ]
  },
  "evidence": {
   "type": "integer",
   "minimum": 0
  },
  "counter": {
   "type": "integer",
   "minimum": 0
  }
 }
}
