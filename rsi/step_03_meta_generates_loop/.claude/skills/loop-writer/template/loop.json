{
 "kind": "counted_while",
 "N": {{budget_fits}},
 "counter": "t",
 "error_still_counts": true,
 "body": [
  "recipe = recipes.json[t - 1]",
  "fit_recipe(recipe)  # one fit; fits_used in state.json is t",
  "write_loop_log(t, recipe, val_score)  # audit only"
 ],
 "exit": [
  "FREEZE",
  "score_test once, with the best val recipe",
  "save_model",
  "scorecard"
 ],
 "illegal": [
  "change N",
  "reorder recipes.json",
  "a second while",
  "score_test before FREEZE",
  "write memory.json",
  "read loop.log back"
 ]
}
