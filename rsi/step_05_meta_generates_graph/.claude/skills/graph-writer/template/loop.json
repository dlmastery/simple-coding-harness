{
 "kind": "counted_while",
 "N": {{budget_fits}},
 "counter": "t",
 "error_still_counts": true,
 "body": [
  "path = paths.json[t - 1]",
  "walk_path(path.id)  # legal: bound to a recipe and fitted; illegal: skipped and counted"
 ],
 "exit": [
  "FREEZE",
  "score_test once, with the best val recipe",
  "save_model",
  "scorecard"
 ],
 "illegal": [
  "change N",
  "reorder paths.json",
  "invent a path",
  "replace an illegal path",
  "a second while",
  "score_test before FREEZE"
 ]
}
