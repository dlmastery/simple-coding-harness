{
  "name": "simple-coding-harness-ts",
  "version": "0.45.0",
  "description": "The stage 15 coding agent loop, ported to TypeScript. Runs on node 22.6+ with no build step.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node --experimental-strip-types agent.ts",
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\"",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "openai": "^4.80.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
